{
  "name": "unifetch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm --filter @unifetch/web dev",
    "test": "vitest run --config apps/web/vitest.config.ts",
    "build": "pnpm typecheck && pnpm --filter @unifetch/web build && pnpm --filter @unifetch/resolver-worker build",
    "typecheck": "vue-tsc --noEmit -p apps/web/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:web": "pnpm --filter @unifetch/web dev",
    "dev:resolver": "pnpm --filter @unifetch/resolver-worker dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.5.0",
    "typescript-eslint": "^8.46.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  }
}
