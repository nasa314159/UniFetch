{
  "name": "@unifetch/resolver-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WRANGLER_SEND_METRICS=false wrangler dev --local --ip 127.0.0.1 --port 8787 --log-level error",
    "dev:diagnostic": "WRANGLER_SEND_METRICS=false wrangler dev src/dev-diagnostic.ts --local --ip 127.0.0.1 --port 8788 --log-level error",
    "build": "tsc --noEmit -p tsconfig.json && WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir dist",
    "deploy": "WRANGLER_SEND_METRICS=false wrangler deploy"
  },
  "dependencies": {
    "@unifetch/core": "workspace:*",
    "@unifetch/meta-resolver": "workspace:*",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
